# Copy to .env and fill in. python-dotenv loads .env automatically in local dev.
# In production (Render/Railway) set these as real environment variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Use your Neon/Render Postgres URL.
# Neon example (note sslmode=require):
#   postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Set DEBUG=False in production. Defaults to False if unset.
DEBUG=True

# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Comma-separated. Add your deploy hostname, e.g. aegis.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: comma-separated full origins for CSRF (https://your-app.onrender.com).
# Hosts in ALLOWED_HOSTS are added automatically, so this is rarely needed.
CSRF_TRUSTED_ORIGINS=

# --- Demo-safety controls ---------------------------------------------------
# Max rows allowed per domain table before new writes are refused.
DEMO_ROW_LIMIT=200
# Per-IP POST budget on write views (django-ratelimit rate syntax).
DEMO_WRITE_RATE=30/m
# Credentials seeded by seed_demo and shown on the login page.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
# Site-wide banner copy.
DEMO_BANNER_TEXT=Demo environment — data resets daily.

# --- Optional ---------------------------------------------------------------
# TIME_ZONE=Asia/Kolkata
# DB_CONN_MAX_AGE=600
# SECURE_HSTS_SECONDS=3600
